<?xml version="1.0"?>
<robot name="safegait_bot">
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <link name="base_link">
    <visual><geometry><cylinder radius="0.30" length="0.10"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder radius="0.30" length="0.10"/></geometry></collision>
    <inertial><mass value="10.0"/><inertia ixx="0.3" iyy="0.3" izz="0.45" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.0025" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.0025" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.25 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.25 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster_front">
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="caster_back">
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="caster_front_joint" type="fixed"><parent link="base_link"/><child link="caster_front"/><origin xyz="0.22 0 -0.05"/></joint>
  <joint name="caster_back_joint" type="fixed"><parent link="base_link"/><child link="caster_back"/><origin xyz="-0.22 0 -0.05"/></joint>

  <link name="arm_mount"><inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="arm_mount_joint" type="fixed"><parent link="base_link"/><child link="arm_mount"/><origin xyz="0.10 0 0.08"/></joint>

  <link name="arm_link_1">
    <visual><origin xyz="0.175 0 0"/><geometry><box size="0.35 0.04 0.03"/></geometry><material name="red"/></visual>
    <collision><origin xyz="0.175 0 0"/><geometry><box size="0.35 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0.175 0 0"/><mass value="0.5"/><inertia ixx="0.0005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="arm_link_2">
    <visual><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.04 0.03"/></geometry><material name="red"/></visual>
    <collision><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0.15 0 0"/><mass value="0.4"/><inertia ixx="0.0004" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="arm_link_3">
    <visual><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.04 0.03"/></geometry><material name="red"/></visual>
    <collision><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0.10 0 0"/><mass value="0.3"/><inertia ixx="0.0003" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="arm_joint_1" type="revolute">
    <parent link="arm_mount"/><child link="arm_link_1"/><origin xyz="0 0 0.00"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" velocity="2.0" effort="30"/><dynamics damping="0.5"/>
  </joint>
  <joint name="arm_joint_2" type="revolute">
    <parent link="arm_link_1"/><child link="arm_link_2"/><origin xyz="0.35 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" velocity="2.0" effort="30"/><dynamics damping="0.5"/>
  </joint>
  <joint name="arm_joint_3" type="revolute">
    <parent link="arm_link_2"/><child link="arm_link_3"/><origin xyz="0.30 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" velocity="2.0" effort="30"/><dynamics damping="0.5"/>
  </joint>
  <link name="ee_link">
    <visual><geometry><sphere radius="0.025"/></geometry><material name="red"/></visual>
  </link>
  <joint name="ee_joint" type="fixed"><parent link="arm_link_3"/><child link="ee_link"/><origin xyz="0.20 0 0"/></joint>

  <gazebo reference="caster_front"><mu1>0</mu1><mu2>0</mu2></gazebo>
  <gazebo reference="caster_back"><mu1>0</mu1><mu2>0</mu2></gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>arm_joint_1</joint_name><use_velocity_commands>true</use_velocity_commands><topic>arm_joint_1/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>arm_joint_2</joint_name><use_velocity_commands>true</use_velocity_commands><topic>arm_joint_2/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>arm_joint_3</joint_name><use_velocity_commands>true</use_velocity_commands><topic>arm_joint_3/cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
